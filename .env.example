# --- Required everywhere ---
OPENAI_API_KEY=

# --- Local dev (uvicorn run directly, no docker-compose) ---
# Not needed on the VPS: docker-compose.yml derives these from the
# POSTGRES_*/companion-redis settings below and injects them itself.
DATABASE_URL=postgresql://user:password@localhost:5432/companion_ai
REDIS_URL=redis://localhost:6379/0

# --- VPS only (consumed by docker-compose.yml) ---
POSTGRES_USER=companion
POSTGRES_PASSWORD=
POSTGRES_DB=companion_ai
# Domain routed to this service by the existing Traefik instance, e.g. api.yourdomain.com
BACKEND_DOMAIN=

# --- Optional (defaults shown in backend/config/settings.py) ---
# pydantic-settings parses list fields as JSON:
# FRONTEND_ORIGINS=["https://your-app.vercel.app"]
FRONTEND_ORIGINS=["http://localhost:3000"]
CHAT_MODEL=gpt-4o-mini
